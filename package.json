{
  "name": "shownet",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "preview": "vite preview",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "icons:verify": "node scripts/verify-app-icons.mjs",
    "tauri": "node scripts/rust-stable.mjs tauri",
    "tauri:bundle": "node scripts/rust-stable.mjs tauri build --config src-tauri/tauri.grok.conf.json --config src-tauri/tauri.local.macos.conf.json",
    "build:windows:cross": "node scripts/rust-stable.mjs tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --no-bundle --config src-tauri/tauri.grok.conf.json -- --locked",
    "build:windows:portable-launcher:cross": "node scripts/rust-stable.mjs xwin build --release --target x86_64-pc-windows-msvc --target-dir src-tauri/target --manifest-path packaging/windows/launcher/Cargo.toml --locked",
    "archive:local-release": "node scripts/archive-local-release.mjs",
    "clean:local-build-cache": "node scripts/clean-local-build-cache.mjs",
    "build:agent-sidecar": "node scripts/build-grok-sidecar.mjs",
    "package:windows:portable": "node scripts/package-windows-portable.mjs",
    "test:windows:portable": "node --experimental-strip-types --test tests/windows-portable-package.test.ts",
    "check:rust": "node scripts/rust-stable.mjs cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust:network": "node scripts/rust-stable.mjs cargo test --manifest-path src-tauri/Cargo.toml local_socket_ -- --ignored",
    "test:browser-drag": "node --experimental-strip-types --test tests/browser-drag.test.ts",
    "test:browser-bus": "node --experimental-strip-types --test tests/browser-bus.test.ts",
    "test:replay-export-ui": "node --experimental-strip-types --test tests/replay-export-ui.test.ts",
    "test:request-list": "node --experimental-strip-types --test tests/request-list.test.ts",
    "test:traffic-workbench": "node --experimental-strip-types --test tests/traffic-workbench.test.ts",
    "test:request-inspector": "node --experimental-strip-types --test tests/request-inspector.test.ts",
    "test:sse-inspector": "node --experimental-strip-types --test tests/sse-inspector.test.ts",
    "test:request-workbench": "node --experimental-strip-types --test tests/request-workbench.test.ts",
    "test:request-collections": "node --experimental-strip-types --test tests/request-collections.test.ts",
    "test:reverse-proxy-ui": "node --experimental-strip-types --test tests/reverse-proxy-ui.test.ts",
    "test:tls-interception-ui": "node --experimental-strip-types --test tests/tls-interception-ui.test.ts",
    "test:tls-golden": "node --experimental-strip-types --test tests/tls-golden-gate.test.ts",
    "test:client-access-ui": "node --experimental-strip-types --test tests/client-access-ui.test.ts",
    "test:mcp-guide": "node --experimental-strip-types --test tests/mcp-client-guide.test.ts",
    "test:analysis-scope": "node --experimental-strip-types --test tests/analysis-scope.test.ts",
    "test:soak-harness": "node --experimental-strip-types --test tests/long-session-soak.test.ts",
    "test:egress": "node scripts/rust-stable.mjs cargo test --manifest-path src-tauri/Cargo.toml live_ -- --ignored --nocapture",
    "test:agent-sidecar": "node scripts/rust-stable.mjs cargo test --manifest-path src-tauri/Cargo.toml grok_runtime::tests::real_sidecar_ -- --ignored --nocapture",
    "benchmark:request-list": "node scripts/rust-stable.mjs cargo test --manifest-path src-tauri/Cargo.toml storage::tests::request_list_performance_benchmark -- --ignored --nocapture --test-threads=1",
    "benchmark:request-query-cancel": "node scripts/rust-stable.mjs cargo test --manifest-path src-tauri/Cargo.toml cancellable_sql_interrupts_in_flight_and_clears_progress_handler -- --nocapture --test-threads=1",
    "soak:long-session": "node scripts/soak-long-session.mjs",
    "check:release": "node scripts/check-release.mjs",
    "verify:release:macos": "node scripts/verify-macos-release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "lucide-react": "https://cdn.npmmirror.com/packages/lucide-react/0.468.0/lucide-react-0.468.0.tgz",
    "qrcode.react": "^4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "https://registry.npmjs.org/@types/node/-/node-20.19.43.tgz",
    "@types/react": "https://registry.npmjs.org/@types/react/-/react-19.2.17.tgz",
    "@types/react-dom": "https://registry.npmjs.org/@types/react-dom/-/react-dom-19.2.3.tgz",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9",
    "vite": "5.4.21"
  }
}
